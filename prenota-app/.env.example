# Supabase — trovi questi valori nel dashboard del tuo progetto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-tua-chiave-anon
SUPABASE_SERVICE_ROLE_KEY=la-tua-chiave-service-role

# Anthropic — per la lettura automatica delle foto dell'agenda (Claude Vision)
# Ottieni la chiave su https://console.anthropic.com
ANTHROPIC_API_KEY=la-tua-chiave-anthropic
